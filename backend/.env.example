DB_URL=jdbc:mysql://localhost:3306/photolib?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=photolib
DB_PASSWORD=change-me

ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-now
ADMIN_DISPLAY_NAME=系统管理员
AUTH_SECURE_COOKIE=true

# 本地开发：设置 STORAGE_MODE=local，或使用 --spring.profiles.active=local。
STORAGE_MODE=local
LOCAL_STORAGE_DIRECTORY=./data/object-storage
LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:8080/api/v1/local-storage/objects
LOCAL_STORAGE_SIGNING_SECRET=replace-with-a-random-local-secret
PREVIEW_COMPRESSION_RATIO=0.6
PREVIEW_BOOTSTRAP_RETRY_DELAY=30s
PHOTO_PROCESSING_THREADS=1
PHOTO_PROCESSING_TEMPORARY_DIRECTORY=./data/photo-processing

# 生产环境：设置 STORAGE_MODE=oss，并填写以下配置。
OSS_BUCKET=your-private-bucket
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 仅在使用专用测试 Bucket 时启用；配置不完整时 OSS 集成测试会跳过。
OSS_INTEGRATION_TEST=false

# 通知外发走企业微信自建应用。三项都填上才会真正投递；留空则成员只收站内信，
# 投递会以 FAILED 落库并产生管理员告警。access_token 由应用自己换取和续期，
# 不需要也不应该在这里配置。申请步骤见 README「企业微信通知接入」。
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 通知里跳转链接的站点地址（不含路径），留空则消息只有正文没有链接。
# 不写协议头时按 https 补全，例如 photowarehouse.cn 等价于 https://photowarehouse.cn。
WECOM_SITE_BASE_URL=
# markdown（默认）标题、加粗和链接都能渲染；但 markdown 消息只有企业微信客户端支持，
# 在微信里用企业微信插件收消息的成员会看到"当前版本不支持该消息类型"。有这种成员就填 text。
WECOM_MESSAGE_TYPE=markdown

# V38 起邮件不再用于通知投递，以下配置仅用于重试历史遗留的邮件投递记录。
DIRECTMAIL_REGION_ID=cn-hangzhou
DIRECTMAIL_ACCOUNT_NAME=
DIRECTMAIL_ACCESS_KEY_ID=
DIRECTMAIL_ACCESS_KEY_SECRET=
